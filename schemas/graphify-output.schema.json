{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hungnv26/2d-3d-knowledge-graph/schemas/graphify-output.schema.json",
  "title": "Graphify output (graphify-out/graph.json)",
  "description": "The part of Graphify's networkx node-link output that kg-graphify reads. Graphify: https://github.com/Graphify-Labs/graphify",
  "type": "object",
  "required": ["nodes", "links"],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "file_type": { "type": "string" },
          "source_file": { "type": ["string", "null"] },
          "community": { "type": ["number", "null"] },
          "community_name": { "type": "string" }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target"],
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string" },
          "relation": { "type": "string" },
          "confidence": { "enum": ["EXTRACTED", "INFERRED", "AMBIGUOUS"] }
        }
      }
    }
  }
}
